---
interface Planet {
  id: number;
  name: string;
  isDestroyed: boolean;
  description: string;
  image: string;
  deletedAt: string | null;
}

interface Props {
  planet: Planet;
}

const { planet } = Astro.props;
---

<article
  class="group overflow-hidden rounded-2xl border border-white/10 bg-zinc-900 transition duration-300 hover:-translate-y-2 hover:border-orange-500/50 hover:shadow-2xl hover:shadow-orange-500/10"
>
  <!-- IMAGEN -->

  <div class="relative h-72 overflow-hidden bg-zinc-950">
    <img
      src={planet.image}
      alt={planet.name}
      loading="lazy"
      class="h-full w-full object-cover transition duration-500 group-hover:scale-110"
    />

    <!-- ID -->

    <span
      class="absolute left-3 top-3 rounded-full bg-black/70 px-3 py-1 text-xs font-bold text-zinc-300 backdrop-blur"
    >
      #{planet.id}
    </span>

    <!-- ESTADO -->

    <span
      class:list={[
        "absolute right-3 top-3 rounded-full px-3 py-1 text-xs font-bold backdrop-blur",
        planet.isDestroyed
          ? "bg-red-500/90 text-white"
          : "bg-emerald-500/90 text-black",
      ]}
    >
      {planet.isDestroyed ? "Destruido" : "Activo"}
    </span>
  </div>

  <!-- INFORMACIÓN -->

  <div class="p-5">
    <h2 class="text-2xl font-black text-white">
      {planet.name}
    </h2>

    <p class="mt-3 line-clamp-3 text-sm leading-6 text-zinc-400">
      {planet.description}
    </p>

    <a
      href={`/planets/${planet.id}`}
      class="mt-6 block rounded-xl border border-white/10 py-3 text-center text-sm font-bold text-white transition hover:bg-orange-500 hover:text-black"
    >
      Ver planeta
    </a>
  </div>
</article>
