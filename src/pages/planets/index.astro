---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import PlanetCard from "../../components/PlanetCard.astro";
import { getPlanets } from "../../services/dragonball";
import SearchBar from "../../components/SearchBar.astro";
export const prerender = false;

interface Planet {
  id: number;
  name: string;
  isDestroyed: boolean;
  description: string;
  image: string;
  deletedAt: string | null;
}

interface PlanetsResponse {
  items: Planet[];
  meta: {
    totalItems: number;
    itemCount: number;
    itemsPerPage: number;
    totalPages: number;
    currentPage: number;
  };
}

const currentPage = Number(Astro.url.searchParams.get("page")) || 1;

const name = Astro.url.searchParams.get("name") || "";

const hasSearch = Boolean(name);

const data = await getPlanets(currentPage, 12, name);

let planets: Planet[] = [];
let totalItems = 0;
let totalPages = 1;
let apiCurrentPage = 1;

/*
 * ==========================
 * SIN BÚSQUEDA
 * ==========================
 */

if (!hasSearch) {
  const response = data as PlanetsResponse;

  planets = response.items;
  totalItems = response.meta.totalItems;
  totalPages = response.meta.totalPages;
  apiCurrentPage = response.meta.currentPage;
}

/*
 * ==========================
 * CON BÚSQUEDA
 * ==========================
 */

if (hasSearch) {
  planets = data as Planet[];

  totalItems = planets.length;
  totalPages = 1;
  apiCurrentPage = 1;
}

/*
 * ==========================
 * PAGINACIÓN
 * ==========================
 */

function getPageUrl(page: number) {
  const params = new URLSearchParams();

  params.set("page", String(page));

  if (name) {
    params.set("name", name);
  }

  return `/planets?${params.toString()}`;
}
---

<Layout title="DragonVerse | Planetas">
  <Navbar />

  <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <!-- ENCABEZADO -->

    <section class="mb-8">
      <span class="text-sm font-bold uppercase tracking-widest text-orange-500">
        Dragon Ball Database
      </span>

      <h1 class="mt-2 text-4xl font-black sm:text-5xl">Planetas</h1>

      <p class="mt-4 max-w-2xl text-zinc-400">
        Explora los planetas del universo Dragon Ball, descubre su estado y
        conoce a los personajes asociados.
      </p>

      <div class="mt-5 text-sm text-zinc-500">
        {totalItems} planetas encontrados
      </div>
    </section>

    <!-- BUSCADOR -->

    <section class="mb-10">
      <SearchBar
        name={name}
        action="/planets"
        label="Buscar planeta"
        placeholder="Escribe el nombre del planeta..."
      />
    </section>

    <!-- RESULTADOS -->

    {
      planets.length > 0 ? (
        <section class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {planets.map((planet) => (
            <PlanetCard planet={planet} />
          ))}
        </section>
      ) : (
        <section class="rounded-2xl border border-white/10 bg-white/[0.03] p-12 text-center">
          <div class="text-5xl">🌎</div>

          <h2 class="mt-5 text-2xl font-black">No encontramos el planeta</h2>

          <p class="mt-3 text-zinc-400">No hay resultados para:</p>

          <p class="mt-2 font-bold text-orange-400">"{name}"</p>

          <a
            href="/planets"
            class="mt-6 inline-block rounded-xl bg-orange-500 px-6 py-3 font-bold text-black transition hover:bg-orange-400"
          >
            Ver todos los planetas
          </a>
        </section>
      )
    }

    <!-- MENSAJE DE BÚSQUEDA -->

    {
      hasSearch && planets.length > 0 && (
        <div class="mt-8 rounded-xl border border-orange-500/20 bg-orange-500/5 p-4 text-center text-sm text-orange-300">
          Resultados para:
          <span class="font-bold">"{name}"</span>
        </div>
      )
    }

    <!-- PAGINACIÓN -->

    {
      !hasSearch && totalPages > 1 && (
        <nav class="mt-12 flex flex-wrap items-center justify-center gap-3">
          {apiCurrentPage > 1 && (
            <a
              href={getPageUrl(apiCurrentPage - 1)}
              class="rounded-xl border border-white/10 px-5 py-3 text-sm font-bold transition hover:bg-white/10 flex items-center gap-1"
            >
              <span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-narrow-left"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M5 12l14 0" />
                  <path d="M5 12l4 4" />
                  <path d="M5 12l4 -4" />
                </svg>
              </span>
              Anterior
            </a>
          )}

          <span class="rounded-xl bg-orange-500 px-5 py-3 text-sm font-black text-black">
            Página {apiCurrentPage} de {totalPages}
          </span>

          {apiCurrentPage < totalPages && (
            <a
              href={getPageUrl(apiCurrentPage + 1)}
              class="rounded-xl border border-white/10 px-5 py-3 text-sm font-bold transition hover:bg-white/10 flex items-center gap-1"
            >
              Siguiente
              <span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-narrow-right"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M5 12l14 0" />
                  <path d="M15 16l4 -4" />
                  <path d="M15 8l4 4" />
                </svg>
              </span>
            </a>
          )}
        </nav>
      )
    }
  </main>
</Layout>
