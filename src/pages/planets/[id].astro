---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import { getPlanets, getPlanet } from "../../services/dragonball";

interface PlanetCharacter {
  id: number;
  name: string;
  ki: string;
  maxKi: string;
  race: string;
  gender: string;
  description: string;
  image: string;
  affiliation: string;
}

interface Planet {
  id: number;
  name: string;
  isDestroyed: boolean;
  description: string;
  image: string;
  deletedAt: string | null;
  characters: PlanetCharacter[];
}

interface PlanetsResponse {
  items: Planet[];
  meta: {
    totalItems: number;
    itemCount: number;
    itemsPerPage: number;
    totalPages: number;
    currentPage: number;
  };
}

/*
 * ==========================
 * GENERAR RUTAS
 * ==========================
 */

export async function getStaticPaths() {
  const firstPage = await getPlanets(1, 12);

  const totalPages = firstPage.meta.totalPages;

  const planets = [...firstPage.items];

  for (let page = 2; page <= totalPages; page++) {
    const data = await getPlanets(page, 12);
    planets.push(...data.items);
  }

  return planets.map((planet) => ({
    params: {
      id: String(planet.id),
    },
  }));
}

/*
 * ==========================
 * OBTENER ID
 * ==========================
 */

const { id } = Astro.params;

if (!id) {
  throw new Error("ID del planeta no encontrado");
}

/*
 * ==========================
 * OBTENER PLANETA
 * ==========================
 */

const planet = (await getPlanet(id)) as Planet;

if (!planet) {
  throw new Error("No se pudo encontrar el planeta");
}
---

<Layout title={`DragonDex | ${planet.name}`}>
  <Navbar />

  <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">

    <!-- VOLVER -->

    <a
      href="/planets"
      class="mb-8 inline-flex items-center gap-2 text-sm font-bold text-zinc-400 transition hover:text-orange-400"
    >
      <span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            stroke="none"
            d="M0 0h24v24H0z"
            fill="none"
          />
          <path d="M5 12h14" />
          <path d="M5 12l4 4" />
          <path d="M5 12l4-4" />
        </svg>
      </span>

      Volver a planetas
    </a>


    <!-- INFORMACIÓN PRINCIPAL -->

    <section
      class="overflow-hidden rounded-3xl border border-white/10 bg-zinc-900 shadow-2xl"
    >

      <div class="grid lg:grid-cols-2">

        <!-- IMAGEN -->

        <div
          class="relative flex min-h-[500px] items-center justify-center overflow-hidden bg-zinc-950 p-8"
        >

          <!-- EFECTO DE FONDO -->

          <div
            class="absolute h-96 w-96 rounded-full bg-orange-500/10 blur-3xl"
          >
          </div>

          <!-- ID -->

          <span
            class="absolute left-6 top-6 rounded-full border border-white/10 bg-black/60 px-4 py-2 text-sm font-bold text-zinc-300 backdrop-blur"
          >
            #{planet.id}
          </span>

          <!-- ESTADO -->

          <span
            class:list={[
              "absolute right-6 top-6 rounded-full px-4 py-2 text-sm font-bold backdrop-blur",
              planet.isDestroyed
                ? "bg-red-500/90 text-white"
                : "bg-emerald-500/90 text-black",
            ]}
          >
            {planet.isDestroyed ? "Planeta destruido" : "Planeta activo"}
          </span>

          <!-- IMAGEN -->

          <img
            src={planet.image}
            alt={planet.name}
            class="relative z-10 max-h-[500px] w-full object-contain drop-shadow-2xl"
          />

        </div>


        <!-- INFORMACIÓN -->

        <div class="flex flex-col justify-center p-8 sm:p-12">

          <span
            class="text-sm font-bold uppercase tracking-[0.3em] text-orange-500"
          >
            Planeta
          </span>

          <h1
            class="mt-3 text-5xl font-black tracking-tight sm:text-6xl"
          >
            {planet.name}
          </h1>

          <p
            class="mt-6 text-base leading-7 text-zinc-400"
          >
            {planet.description}
          </p>


          <!-- ESTADÍSTICAS -->

          <div class="mt-8 grid grid-cols-2 gap-4">

            <!-- ID -->

            <div
              class="rounded-2xl border border-white/10 bg-white/[0.03] p-5"
            >
              <p
                class="text-xs font-bold uppercase tracking-wider text-zinc-500"
              >
                ID
              </p>

              <p
                class="mt-2 text-lg font-bold text-white"
              >
                #{planet.id}
              </p>
            </div>


            <!-- ESTADO -->

            <div
              class:list={[
                "rounded-2xl p-5",
                planet.isDestroyed
                  ? "border border-red-500/20 bg-red-500/5"
                  : "border border-emerald-500/20 bg-emerald-500/5",
              ]}
            >

              <p
                class="text-xs font-bold uppercase tracking-wider text-zinc-500"
              >
                Estado
              </p>

              <p
                class:list={[
                  "mt-2 text-lg font-black",
                  planet.isDestroyed
                    ? "text-red-400"
                    : "text-emerald-400",
                ]}
              >
                {planet.isDestroyed
                  ? "Destruido"
                  : "Activo"}
              </p>

            </div>

          </div>


          <!-- PERSONAJES -->

          <div
            class="mt-4 rounded-2xl border border-orange-500/20 bg-orange-500/5 p-5"
          >

            <p
              class="text-xs font-bold uppercase tracking-wider text-zinc-500"
            >
              Personajes
            </p>

            <p
              class="mt-2 text-lg font-black text-orange-400"
            >
              {planet.characters?.length || 0}
              personajes
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- PERSONAJES DEL PLANETA -->

    {
      planet.characters?.length > 0 && (
        <section class="mt-12">

          <div class="mb-6">

            <span
              class="text-sm font-bold uppercase tracking-widest text-orange-500"
            >
              Universo
            </span>

            <h2 class="mt-2 text-3xl font-black">
              Personajes del planeta
            </h2>

            <p class="mt-2 text-zinc-400">
              Personajes asociados a {planet.name}.
            </p>

          </div>


          <div
            class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
          >

            {planet.characters.map((character) => (

              <article
                class="group overflow-hidden rounded-2xl border border-white/10 bg-zinc-900 transition duration-300 hover:-translate-y-2 hover:border-orange-500/50 hover:shadow-2xl hover:shadow-orange-500/10"
              >

                <!-- IMAGEN -->

                <div
                  class="relative h-72 overflow-hidden bg-zinc-950"
                >

                  <img
                    src={character.image}
                    alt={character.name}
                    loading="lazy"
                    class="h-full w-full object-contain transition duration-500 group-hover:scale-110"
                  />

                  <span
                    class="absolute left-3 top-3 rounded-full bg-black/70 px-3 py-1 text-xs font-bold text-zinc-300 backdrop-blur"
                  >
                    #{character.id}
                  </span>

                </div>


                <!-- INFORMACIÓN -->

                <div class="p-5">

                  <h3
                    class="text-2xl font-black text-white"
                  >
                    {character.name}
                  </h3>

                  <div
                    class="mt-4 space-y-2 text-sm"
                  >

                    <div class="flex justify-between">
                      <span class="text-zinc-500">
                        Raza
                      </span>

                      <span class="font-medium text-zinc-200">
                        {character.race}
                      </span>
                    </div>

                    <div class="flex justify-between">
                      <span class="text-zinc-500">
                        Afiliación
                      </span>

                      <span class="font-medium text-zinc-200">
                        {character.affiliation}
                      </span>
                    </div>

                  </div>


                  <a
                    href={`/characters/${character.id}`}
                    class="mt-6 block rounded-xl border border-white/10 py-3 text-center text-sm font-bold text-white transition hover:bg-orange-500 hover:text-black"
                  >
                    Ver personaje
                  </a>

                </div>

              </article>

            ))}

          </div>

        </section>
      )
    }


    <!-- SIN PERSONAJES -->

    {
      (!planet.characters ||
        planet.characters.length === 0) && (
        <section
          class="mt-12 rounded-2xl border border-white/10 bg-white/[0.03] p-12 text-center"
        >

          <div class="text-5xl">
            🌌
          </div>

          <h2 class="mt-5 text-2xl font-black">
            Sin personajes registrados
          </h2>

          <p class="mt-3 text-zinc-400">
            No hay personajes asociados a este planeta.
          </p>

        </section>
      )
    }

  </main>
</Layout>