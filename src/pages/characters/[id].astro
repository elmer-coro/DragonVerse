---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import { getCharacters, getCharacter } from "../../services/dragonball.js";

export async function getStaticPaths() {
  const data = await getCharacters(1, 100);

  return data.items.map((character) => ({
    params: {
      id: String(character.id),
    },
  }));
}

const { id } = Astro.params;

if (!id) {
  throw new Error("ID del personaje no encontrado");
}

const character = await getCharacter(id);
---

<Layout title={`DragonDex | ${character.name}`}>
  <Navbar />

  <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <!-- Volver -->
    <a
      href="/characters"
      class="mb-8 inline-flex items-center gap-2 text-sm font-bold text-zinc-400 transition hover:text-orange-400"
    >
      <span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-narrow-left"
          ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
            d="M5 12l14 0"></path><path d="M5 12l4 4"></path><path
            d="M5 12l4 -4"></path></svg
        >
      </span> Volver a personajes
    </a>

    <!-- Información principal -->
    <section
      class="overflow-hidden rounded-3xl border border-white/10 bg-zinc-900 shadow-2xl"
    >
      <div class="grid lg:grid-cols-2">
        <!-- Imagen -->
        <div
          class="relative flex min-h-[500px] items-center justify-center overflow-hidden bg-zinc-950 p-8"
        >
          <div
            class="absolute h-96 w-96 rounded-full bg-orange-500/10 blur-3xl"
          >
          </div>

          <span
            class="absolute left-6 top-6 rounded-full border border-white/10 bg-black/60 px-4 py-2 text-sm font-bold text-zinc-300 backdrop-blur"
          >
            #{character.id}
          </span>

          <img
            src={character.image}
            alt={character.name}
            class="relative z-10 max-h-[520px] w-full object-contain drop-shadow-2xl"
          />
        </div>

        <!-- Información -->
        <div class="flex flex-col justify-center p-8 sm:p-12">
          <span
            class="text-sm font-bold uppercase tracking-[0.3em] text-orange-500"
          >
            Personaje
          </span>

          <h1 class="mt-3 text-5xl font-black tracking-tight sm:text-6xl">
            {character.name}
          </h1>

          <p class="mt-6 text-base leading-7 text-zinc-400">
            {character.description}
          </p>

          <!-- Estadísticas -->
          <div class="mt-8 grid grid-cols-2 gap-4">
            <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
              <p
                class="text-xs font-bold uppercase tracking-wider text-zinc-500"
              >
                Raza
              </p>

              <p class="mt-2 text-lg font-bold text-white">
                {character.race}
              </p>
            </div>

            <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
              <p
                class="text-xs font-bold uppercase tracking-wider text-zinc-500"
              >
                Género
              </p>

              <p class="mt-2 text-lg font-bold text-white">
                {character.gender}
              </p>
            </div>

            <div
              class="rounded-2xl border border-orange-500/20 bg-orange-500/5 p-5"
            >
              <p
                class="text-xs font-bold uppercase tracking-wider text-zinc-500"
              >
                Ki
              </p>

              <p class="mt-2 text-lg font-black text-orange-400">
                {character.ki}
              </p>
            </div>

            <div
              class="rounded-2xl border border-orange-500/20 bg-orange-500/5 p-5"
            >
              <p
                class="text-xs font-bold uppercase tracking-wider text-zinc-500"
              >
                Ki máximo
              </p>

              <p class="mt-2 text-lg font-black text-orange-400">
                {character.maxKi}
              </p>
            </div>
          </div>

          <!-- Afiliación -->
          <div
            class="mt-4 rounded-2xl border border-white/10 bg-white/[0.03] p-5"
          >
            <p class="text-xs font-bold uppercase tracking-wider text-zinc-500">
              Afiliación
            </p>

            <p class="mt-2 text-lg font-bold text-white">
              {character.affiliation}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Transformaciones -->
    {
      character.transformations?.length > 0 && (
        <section class="mt-12">
          <div class="mb-6">
            <span class="text-sm font-bold uppercase tracking-widest text-orange-500">
              Poder
            </span>

            <h2 class="mt-2 text-3xl font-black">Transformaciones</h2>
          </div>

          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {character.transformations.map((transformation) => (
              <article class="overflow-hidden rounded-2xl border border-white/10 bg-zinc-900">
                <div class="flex h-72 items-center justify-center bg-zinc-950 p-6">
                  <img
                    src={transformation.image}
                    alt={transformation.name}
                    class="h-full w-full object-contain"
                    loading="lazy"
                  />
                </div>

                <div class="p-5">
                  <h3 class="text-xl font-black">{transformation.name}</h3>

                  <p class="mt-2 text-sm text-orange-400">
                    Ki: {transformation.ki}
                  </p>
                </div>
              </article>
            ))}
          </div>
        </section>
      )
    }
  </main>
</Layout>
